
[pycodestyle]
max-line-length = 88

[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .eggs,
    *.egg-info,
    build,
    dist,
    .env,
    venv

[flake8]
max-line-length = 100
exclude = .git,__pycache__,venv,.venv,build,dist
ignore = E203,W503
